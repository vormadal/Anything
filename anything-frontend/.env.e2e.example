# E2E test configuration
# Copy this file to .env.e2e and adjust values as needed.
# Default values match the local Aspire development setup.

E2E_BASE_URL=http://localhost:3001
E2E_ADMIN_EMAIL=admin@anything.local
E2E_ADMIN_PASSWORD=Admin123!

# Direct API URL used for test setup/teardown API calls (e.g. resetting food plan settings).
# Defaults to http://localhost:5238 if not set.
# Override if the API runs on a different port (e.g. when Aspire assigns a dynamic port).
# E2E_API_URL=http://localhost:5238
