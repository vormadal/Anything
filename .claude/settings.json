{
  "permissions": {
    "allow": [
      "Bash(jq:*)",
      "Bash(tail:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(grep:*)",
      "Bash(python3:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet ef:*)",
      "Bash(dotnet tool:*)",
      "Bash(dotnet test:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(sed:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}